--Question 1:COUNT:How many sales records are in the table?
SELECT COUNT(*) AS Total_sales
FROM exercise2.default.sales;

--Question 2: SUM:What is the total quantity of products sold?
  SELECT SUM(Quantity ) AS Total_quantity 
  FROM exercise2.default.sales;

  --Question 3: AVG:What is the average product price?
  SELECT AVG(Price) AS Average_price
  FROM exercise2.default.sales;

--Question 4: MIN:What is the lowest product price?
SELECT MIN(Price) AS Lowest_price 
FROM exercise2.default.sales;

--Question 5: MAX: What is the highest product price? 
SELECT MAX(Price) AS highest_price 
FROM exercise2.default.sales;

--Question 6: SUM: What is the total revenue?
SELECT SUM(Quantity * Price) AS Total_revenue 
FROM exercise2.default.sales;

--  Question 7:GROUP BY: Total quantity sold for each category 
SELECT category, SUM(Quantity) AS Total_quantity
FROM exercise2.default.sales
GROUP BY category;
