-- step 1: CREATE A CATALOG 
CREATE  CATALOG IF NOT EXISTS exercise2;

--Step 2: Create a schema 
CREATE  SCHEMA IF NOT EXISTS exercise2.default;

--step 3: Create a table 
CREATE TABLE IF NOT EXISTS exercise2.default.sales (
sale_id INT,
product STRING,
category STRING,
Quantity INT,
Price INT
);

--step 4: Insert the data into the table
